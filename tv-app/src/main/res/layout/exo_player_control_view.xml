<?xml version="1.0" encoding="utf-8"?>
<!-- Media3 会自动绑定 exo_progress、exo_position、exo_duration 和 exo_play_pause。 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_controller_panel"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="24dp"
        android:paddingEnd="36dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/controller_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            app:buffered_color="#7791AA"
            app:played_color="#FF9650"
            app:scrubber_color="#FFFFFF"
            app:unplayed_color="#496078" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                android:textColor="#B8C7D5"
                android:textSize="15sp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8C7D5"
                android:textSize="15sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@id/exo_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="播放或暂停"
                android:focusable="true"
                android:padding="12dp" />

            <Button
                android:id="@+id/choose"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="选集" />

            <Button
                android:id="@+id/private_listening"
                style="@style/PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="同屏自在听" />

            <Button
                android:id="@+id/realign_audio"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="音画对齐"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</merge>
