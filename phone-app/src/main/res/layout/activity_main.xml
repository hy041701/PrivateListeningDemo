<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="38dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_brand_mark"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/listening_mark"
            android:textColor="#101820"
            android:textSize="35sp" />

        <TextView
            style="@style/PhonePageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_title" />

        <TextView
            style="@style/PhonePageSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/app_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/connection_indicator"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_status_indicator" />

                <TextView
                    style="@style/PhoneCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="@string/connection_status_label" />
            </LinearLayout>

            <TextView
                android:id="@+id/connection_status"
                style="@style/PhoneCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/not_connected" />

            <TextView
                android:id="@+id/connection_detail"
                style="@style/PhoneBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/same_wifi_hint" />
        </LinearLayout>

        <Button
            android:id="@+id/scan_tv"
            style="@style/PhonePrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="@string/scan_tv" />

        <LinearLayout
            android:id="@+id/session_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/realign_tv"
                style="@style/PhoneButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/realign_tv" />

            <Button
                android:id="@+id/disconnect_tv"
                style="@style/PhoneButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/exit_listening" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_surface_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icon_surface"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/headphone_mark"
                android:textColor="#FFB079"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/PhoneCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/headphone_status" />

                <TextView
                    android:id="@+id/headphones"
                    style="@style/PhoneCardValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/checking_headphones" />
            </LinearLayout>

            <View
                android:id="@+id/headphone_indicator"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_status_indicator" />
        </LinearLayout>

        <Button
            android:id="@+id/select_audio_output"
            style="@style/PhoneButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="@string/select_audio_output" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/PhoneCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/timeline_diagnostics_title" />

            <TextView
                android:id="@+id/timeline_diagnostics"
                style="@style/PhoneBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:text="@string/timeline_diagnostics_waiting"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/PhoneCardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="电视端采样" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#33526A8A" />

                <TextView
                    style="@style/PhoneCardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="手机端采样" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_timeline_column"
                    style="@style/PhoneBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:paddingEnd="8dp"
                    android:text="等待电视端采样…"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#33526A8A" />

                <TextView
                    android:id="@+id/phone_timeline_column"
                    style="@style/PhoneBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:paddingStart="8dp"
                    android:text="等待手机端采样…"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/timeline_diagnostics_details"
                style="@style/PhoneBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            style="@style/PhoneFootnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="@string/listening_requirements" />
    </LinearLayout>
</ScrollView>
